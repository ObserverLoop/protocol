{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.observerloop.com/ol/v1/payload/command.result.json",
  "title": "command.result",
  "description": "The outcome of a command.requested, addressed to the requester. Request-scoped: the durable record of what the command changed is the thread or audit event it produced.",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "status"],
  "properties": {
    "command_id": { "$ref": "../common.json#/$defs/identifier" },
    "status": { "enum": ["accepted", "rejected", "failed", "completed"] },
    "detail": { "type": "string", "maxLength": 8192 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "maxLength": 4096 }
      }
    },
    "result": { "type": "object" }
  }
}
