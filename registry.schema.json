{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.observerloop.com/ol/v1/registry.schema.json",
  "title": "ObserverLoop event registry",
  "description": "Structural schema for registry.yaml. Cross-field rules that JSON Schema cannot express - every event's subject_class must be defined, every stream's subject_classes must be defined, every schema path must exist, and type tokens must be unique - are enforced by the registry loader in cmd/protoc-registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject_classes", "streams", "events"],
  "properties": {
    "version": {
      "description": "Protocol MAJOR.MINOR.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "subject_classes": {
      "description": "Subject templates keyed by class name. {type} must be the final token.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/className" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^ol\\.v[0-9]+\\.[a-z0-9.{}_-]+\\.\\{type\\}$"
      }
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stream" }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "className": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "duration": {
      "description": "Go duration literal.",
      "type": "string",
      "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "subject_classes",
        "retention",
        "max_age",
        "discard",
        "duplicate_window"
      ],
      "properties": {
        "name": {
          "description": "Stream name prefix. The workspace identifier is appended.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "subject_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/className" }
        },
        "retention": { "enum": ["limits", "workqueue"] },
        "max_age": { "$ref": "#/$defs/duration" },
        "discard": { "enum": ["old", "new"] },
        "duplicate_window": { "$ref": "#/$defs/duration" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema",
        "subject_class",
        "durability",
        "trust_domains",
        "capabilities"
      ],
      "properties": {
        "type": {
          "description": "The one identifier: event type, subject leaf, and schema basename.",
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        },
        "schema": {
          "type": "string",
          "pattern": "^schemas/payload/[a-z0-9.-]+\\.json$"
        },
        "subject_class": { "$ref": "#/$defs/className" },
        "durability": { "enum": ["jetstream", "core"] },
        "trust_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["tenant", "saas-attested"] }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
          }
        }
      }
    }
  }
}
