{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.observerloop.com/ol/v1/payload/agent.lifecycle.json",
  "title": "agent.lifecycle",
  "description": "A transition in one agent process's lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "state"],
  "properties": {
    "agent_id": { "$ref": "../common.json#/$defs/identifier" },
    "state": {
      "enum": ["starting", "running", "blocked", "stopping", "stopped", "failed"]
    },
    "harness": { "type": "string", "maxLength": 64 },
    "definition_digest": { "$ref": "../common.json#/$defs/digest" },
    "reason": { "type": "string", "maxLength": 4096 }
  }
}
