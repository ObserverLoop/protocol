  "invalid": [
    {
      "fixture": "fixtures/invalid/conductor-id-without-epoch.json",
      "reason": "conductor_epoch is the fencing token and is required whenever source_conductor_id is present"
    },
    {
      "fixture": "fixtures/invalid/delegation-chain-too-deep.json",
      "reason": "maximum delegation depth below a root is two"
    },
    {
      "fixture": "fixtures/invalid/identifier-too-long.json",
      "reason": "identifiers are bounded at 63 bytes"
    },
    {
      "fixture": "fixtures/invalid/identifier-uppercase.json",
      "reason": "the identifier grammar is lowercase only"
    },
    {
      "fixture": "fixtures/invalid/identifier-with-dot.json",
      "reason": "a dot in an identifier would add a subject token"
    },
    {
      "fixture": "fixtures/invalid/identifier-with-wildcard.json",
      "reason": "a NATS wildcard in an identifier would make subject authorisation unsound"
    },
    {
      "fixture": "fixtures/invalid/malformed-version.json",
      "reason": "protocol_version is not MAJOR.MINOR"
    },
    {
      "fixture": "fixtures/invalid/missing-payload.json",
      "reason": "payload is required and is validated against the schema for event_type"
    },
    {
      "fixture": "fixtures/invalid/missing-signature.json",
      "reason": "signature is required on every envelope"
    },
    {
      "fixture": "fixtures/invalid/negative-sequence.json",
      "reason": "sequence is a monotonic counter and is never negative"
    },
    {
      "fixture": "fixtures/invalid/payload-missing-required-field.json",
      "reason": "chat.message requires text"
    },
    {
      "fixture": "fixtures/invalid/payload-reasoning-property.json",
      "reason": "no payload may carry reasoning content; the schema has nowhere to put it"
    },
    {
      "fixture": "fixtures/invalid/payload-unknown-property.json",
      "reason": "every payload root is closed, so an unknown property is a violation"
    },
    {
      "fixture": "fixtures/invalid/payload-wrong-enum.json",
      "reason": "role is constrained to human, agent, or system"
    },
    {
      "fixture": "fixtures/invalid/permission-actor-mixes-variants.json",
      "reason": "permission.resolved actor is one of two shapes, so an object carrying both the attested human and the signing key matches neither: both are closed, and a record that claims two identities for one approver names none of them"
    },
    {
      "fixture": "fixtures/invalid/permission-actor-without-discriminator.json",
      "reason": "an actor carrying a key_id but no kind satisfies neither shape: the signing key variant requires its discriminator, and a consumer is never asked to infer the variant from which fields are present"
    },
    {
      "fixture": "fixtures/invalid/permission-arguments-too-long.json",
      "reason": "permission.requested.arguments is bounded at 2048 characters; an emitter that renders a whole file into the field a human reads is rejected rather than truncated for it, because truncating on the reader's side is what loses the guarantee that the published string is a prefix of the one the publisher stored"
    },
    {
      "fixture": "fixtures/invalid/permission-redacted-not-boolean.json",
      "reason": "redacted is a boolean, not prose. It is the flag that tells a reader the published arguments are not verbatim, and a consumer that had to interpret a string here could read a truthy \"no\""
    },
    {
      "fixture": "fixtures/invalid/query-harness-list-with-limit.json",
      "reason": "harness.list answers with the whole catalogue and no page around it; a request that asks for a page of it has misunderstood what it is asking, and a client that received half the harnesses would offer half the choice with nothing saying so"
    },
    {
      "fixture": "fixtures/invalid/query-history-without-thread.json",
      "reason": "kind thread.history must name the thread it asks about; without thread_id the request cannot be answered and must not be guessed at"
    },
    {
      "fixture": "fixtures/invalid/query-limit-over-bound.json",
      "reason": "limit is bounded at 100 because the reply must fit inside one core NATS message; a request for more is refused rather than silently reduced"
    },
    {
      "fixture": "fixtures/invalid/query-result-client-under-wrong-kind.json",
      "reason": "each kind carries its own answer and no other; a status result holding a client would have a client read what the deployment is running as what the deployment makes of its key"
    },
    {
      "fixture": "fixtures/invalid/query-result-error-with-answer.json",
      "reason": "a result that failed carries no answer beside the failure; half a page that does not say it is half is worse than a refusal"
    },
    {
      "fixture": "fixtures/invalid/query-result-harnesses-under-wrong-kind.json",
      "reason": "each kind carries its own answer and no other; a status result holding the harness catalogue would have a client read what the daemon is running as what a thread may be opened on, and offer a choice that was never on offer"
    },
    {
      "fixture": "fixtures/invalid/query-result-kind-mismatch.json",
      "reason": "each kind carries its own answer and no other; a thread.history result holding threads would have a client read the wrong field and find something that looks right"
    },
    {
      "fixture": "fixtures/invalid/query-result-withdrawn-client-named.json",
      "reason": "a key that is not accepted carries its status and nothing else; what a deployment called a key it no longer accepts, and what it used to permit, is not an answer to what that key may do now"
    },
    {
      "fixture": "fixtures/invalid/query-status-with-thread.json",
      "reason": "only thread.history is about a thread; a status request that names one has misunderstood what it is asking and is refused rather than answered about something else"
    },
    {
      "fixture": "fixtures/invalid/short-signature.json",
      "reason": "an Ed25519 signature is 64 bytes, 86 base64url characters"
    },
    {
      "fixture": "fixtures/invalid/timestamp-with-offset.json",
      "reason": "occurred_at is UTC; an offset would canonicalise differently"
    },
    {
      "fixture": "fixtures/invalid/timestamp-without-milliseconds.json",
      "reason": "occurred_at is RFC 3339 UTC at exactly millisecond precision, because it is inside the signed canonical form"
    },
    {
      "fixture": "fixtures/invalid/tool-call-carries-arguments.json",
      "reason": "tool.call carries no tool arguments; the payload root is closed, so a verbatim argument dump has nowhere to go"
    },
    {
      "fixture": "fixtures/invalid/tool-call-target-reference-too-long.json",
      "reason": "target.reference is bounded at 2048 characters; an emitter that renders a whole invocation into it is rejected rather than truncated"
    },
    {
      "fixture": "fixtures/invalid/tool-result-carries-output.json",
      "reason": "tool output is never published; the payload root is closed, so verbatim output cannot reach the stream even when a publisher tries"
    },
    {
      "fixture": "fixtures/invalid/tool-result-failed-without-error.json",
      "reason": "an outcome other than succeeded requires error, so a failure can never be recorded without a cause"
    },
    {
      "fixture": "fixtures/invalid/unknown-event-type.json",
      "reason": "event_type is in no registry entry, so no payload schema exists for it"
    },
    {
      "fixture": "fixtures/invalid/unknown-trust-domain.json",
      "reason": "trust_domain is closed to tenant and saas-attested"
    },
    {
      "fixture": "fixtures/invalid/unsupported-major.json",
      "reason": "protocol_version declares a MAJOR this binding does not implement; an unknown MAJOR is rejected while an unknown MINOR is accepted"
    }
  ],
  "signing_key": "fixtures/signing/key.json",
  "signing_vectors": "fixtures/signing/vectors.json"
}
