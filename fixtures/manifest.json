  "invalid": [
    {
      "fixture": "fixtures/invalid/conductor-id-without-epoch.json",
      "reason": "conductor_epoch is the fencing token and is required whenever source_conductor_id is present"
    },
    {
      "fixture": "fixtures/invalid/delegation-chain-too-deep.json",
      "reason": "maximum delegation depth below a root is two"
    },
    {
      "fixture": "fixtures/invalid/identifier-too-long.json",
      "reason": "identifiers are bounded at 63 bytes"
    },
    {
      "fixture": "fixtures/invalid/identifier-uppercase.json",
      "reason": "the identifier grammar is lowercase only"
    },
    {
      "fixture": "fixtures/invalid/identifier-with-dot.json",
      "reason": "a dot in an identifier would add a subject token"
    },
    {
      "fixture": "fixtures/invalid/identifier-with-wildcard.json",
      "reason": "a NATS wildcard in an identifier would make subject authorisation unsound"
    },
    {
      "fixture": "fixtures/invalid/malformed-version.json",
      "reason": "protocol_version is not MAJOR.MINOR"
    },
    {
      "fixture": "fixtures/invalid/missing-payload.json",
      "reason": "payload is required and is validated against the schema for event_type"
    },
    {
      "fixture": "fixtures/invalid/missing-signature.json",
      "reason": "signature is required on every envelope"
    },
    {
      "fixture": "fixtures/invalid/negative-sequence.json",
      "reason": "sequence is a monotonic counter and is never negative"
    },
    {
      "fixture": "fixtures/invalid/payload-missing-required-field.json",
      "reason": "chat.message requires text"
    },
    {
      "fixture": "fixtures/invalid/payload-reasoning-property.json",
      "reason": "no payload may carry reasoning content; the schema has nowhere to put it"
    },
    {
      "fixture": "fixtures/invalid/payload-unknown-property.json",
      "reason": "every payload root is closed, so an unknown property is a violation"
    },
    {
      "fixture": "fixtures/invalid/payload-wrong-enum.json",
      "reason": "role is constrained to human, agent, or system"
    },
    {
      "fixture": "fixtures/invalid/short-signature.json",
      "reason": "an Ed25519 signature is 64 bytes, 86 base64url characters"
    },
    {
      "fixture": "fixtures/invalid/timestamp-with-offset.json",
      "reason": "occurred_at is UTC; an offset would canonicalise differently"
    },
    {
      "fixture": "fixtures/invalid/timestamp-without-milliseconds.json",
      "reason": "occurred_at is RFC 3339 UTC at exactly millisecond precision, because it is inside the signed canonical form"
    },
    {
      "fixture": "fixtures/invalid/tool-call-carries-arguments.json",
      "reason": "tool.call carries no tool arguments; the payload root is closed, so a verbatim argument dump has nowhere to go"
    },
    {
      "fixture": "fixtures/invalid/tool-call-target-reference-too-long.json",
      "reason": "target.reference is bounded at 2048 characters; an emitter that renders a whole invocation into it is rejected rather than truncated"
    },
    {
      "fixture": "fixtures/invalid/tool-result-carries-output.json",
      "reason": "tool output is never published; the payload root is closed, so verbatim output cannot reach the stream even when a publisher tries"
    },
    {
      "fixture": "fixtures/invalid/tool-result-failed-without-error.json",
      "reason": "an outcome other than succeeded requires error, so a failure can never be recorded without a cause"
    },
    {
      "fixture": "fixtures/invalid/unknown-event-type.json",
      "reason": "event_type is in no registry entry, so no payload schema exists for it"
    },
    {
      "fixture": "fixtures/invalid/unknown-trust-domain.json",
      "reason": "trust_domain is closed to tenant and saas-attested"
    },
    {
      "fixture": "fixtures/invalid/unsupported-major.json",
      "reason": "protocol_version declares a MAJOR this binding does not implement; an unknown MAJOR is rejected while an unknown MINOR is accepted"
    }
  ],
  "signing_key": "fixtures/signing/key.json",
  "signing_vectors": "fixtures/signing/vectors.json"
}
